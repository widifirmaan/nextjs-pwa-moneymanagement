{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextjs-pwa-moneymanagement",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "MONEY_DB",
      "database_name": "monew-db",
      "database_id": "6cacd667-88ef-47ff-a98b-7c250bdae8af"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MONEY_IMAGES",
      "bucket_name": "monew-images"
    }
  ],
  "routes": [
    {
      "pattern": "money.widifirmaan.web.id",
      "zone_name": "widifirmaan.web.id",
      "custom_domain": true
    }
  ]
}
