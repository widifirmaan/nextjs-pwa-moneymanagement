{
  "name": "monew",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "MONEY_DB",
      "database_name": "monew-db",
      "database_id": "6cacd667-88ef-47ff-a98b-7c250bdae8af"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MONEY_IMAGES",
      "bucket_name": "monew-images"
    }
  ],
  "vars": {}
}
