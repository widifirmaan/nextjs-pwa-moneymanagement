# JWT signing secret (defaults to "dev-secret" in local development)
JWT_SECRET=local-dev-secret-change-me

# Optional: remote LibSQL / Turso database for serverless deployments (e.g. Vercel)
# Leave unset for zero-config local SQLite (local.db)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
